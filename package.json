{
  "name": "ailoom",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "turbo run build --filter=@app/shared --output-logs=errors-only && pnpm --filter @app/api db:migrate",
    "db:revert": "turbo run build --filter=@app/shared --output-logs=errors-only && pnpm --filter @app/api db:revert",
    "db:generate": "turbo run build --filter=@app/shared --output-logs=errors-only && pnpm --filter @app/api db:generate",
    "db:check": "turbo run build --filter=@app/shared --output-logs=errors-only && pnpm --filter @app/api db:check",
    "secrets:generate": "pnpm --silent --filter @app/api secrets:generate",
    "e2e": "pnpm --filter @app/e2e test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.2",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
