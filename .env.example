# Environment configuration for ailoom (see docs/spec.md section 21).
#
# Copy this file to .env and fill in the required variables (the uncommented ones).
# Optional variables are commented out and show their default; uncomment to change one.
# An empty value counts as unset. The process refuses to start and lists every problem
# when a value is invalid.
#
# Run `pnpm secrets:generate` to print fresh AUTH_SECRET, WIDGET_SECRET, CHALLENGE_SECRET
# and ENCRYPTION_KEYS values. No telemetry exists, so there is no telemetry setting.

# --- Core ---

# Runtime mode: development, test or production
# NODE_ENV=development
# Demo/demo-GIF stacks only: allows the mock chat provider in a production build.
# Never enable on an instance that accepts real users.
# DEMO_MODE=false

# e.g. https://support.example.com; used in emails, widget snippet, Caddy
PUBLIC_URL=

# Log level: fatal, error, warn, info, debug or trace
# LOG_LEVEL=info

# --- Database ---

# Postgres connection string. Under deploy/docker-compose.yml this is ignored: compose builds
# it from the POSTGRES_* values below (postgres://USER:PASSWORD@postgres:5432/DB).
DATABASE_URL=

# Direct (non-PgBouncer) connection for LISTEN/NOTIFY; defaults to DATABASE_URL
# DATABASE_LISTEN_URL=

# true, false, or require
# DATABASE_SSL=false

# PEM path; when set, certificates are verified
# DATABASE_SSL_CA=

# --- Docker Compose stack (deploy/docker-compose.yml) ---
# Only compose reads these (the api ignores them), so they are listed here rather than set.
# Run compose from the repo root with this file as its --env-file:
#   docker compose -f deploy/docker-compose.yml --env-file .env up -d --build --wait
# and add to .env:
#   POSTGRES_USER      role the postgres container creates, e.g. ailoom (required)
#   POSTGRES_PASSWORD  its password (required); keep it URL-safe, e.g. `openssl rand -hex 24`,
#                      since compose embeds it in DATABASE_URL
#   POSTGRES_DB        database name, e.g. ailoom (required)
#   HTTP_PORT          host port Caddy publishes for HTTP (default 80); for an http:// PUBLIC_URL
#                      it must be the URL's port, e.g. PUBLIC_URL=http://localhost:8080 + 8080
#   HTTPS_PORT         host port for HTTPS, used by an https:// PUBLIC_URL (default 443)
#   VERSION            api/web image tag (default latest)
#   IMAGE_OWNER        ghcr.io owner of the images (default li4nee)
# The postgres container receives only the three POSTGRES_* values; the app services read
# this whole file.

# --- Secrets ---

# >= 32 bytes; signs admin access JWTs. Comma-separated list for rotation (first signs, all verify)
AUTH_SECRET=

# >= 32 bytes; signs visitor tokens
WIDGET_SECRET=

# >= 32 bytes; signs proof-of-work challenges. Required if any bot uses challenges
# CHALLENGE_SECRET=

# v1:<64 hex>[,v0:<64 hex>]; the highest version encrypts, every entry decrypts
ENCRYPTION_KEYS=

# Optional OAuth clients for native CRM authorization-code connections. Register the callback
# URL PUBLIC_URL/v1/integrations/oauth/callback/<provider> with each provider application. Omit providers
# that you do not plan to connect with OAuth; private/API-key credentials remain separate.
# CRM_OAUTH_CLIENTS={"hubspot":{"clientId":"...","clientSecret":"..."}}

# --- Sessions ---

# Admin access JWT lifetime in minutes
# ACCESS_TOKEN_TTL_MIN=15

# Refresh token / session lifetime in days
# REFRESH_TOKEN_TTL_DAYS=30

# --- Sign-up ---

# open, invite, closed
# SIGNUP_MODE=invite

# --- Email ---

# smtp, resend, none (logs emails)
# EMAIL_TRANSPORT=none

# Sender address, e.g. Support <support@example.com>. Required if email is enabled
# EMAIL_FROM=

# SMTP server host. Required if EMAIL_TRANSPORT=smtp
# SMTP_HOST=

# SMTP server port; defaults to 587, or 465 when SMTP_SECURE=true
# SMTP_PORT=

# SMTP login, if the server needs one
# SMTP_USER=
# SMTP_PASS=

# true for an implicit-TLS connection (usually port 465), false for STARTTLS
# SMTP_SECURE=false

# Resend API key. Required if EMAIL_TRANSPORT=resend
# RESEND_API_KEY=

# --- Storage ---

# Local file storage (volume); an absolute path
# STORAGE_DIR=/data/files

# Largest accepted upload, in megabytes
# MAX_UPLOAD_MB=20

# --- Crawling ---

# Per sitemap source
# CRAWL_MAX_PAGES=500

# Obey robots.txt when crawling
# CRAWL_RESPECT_ROBOTS=true

# User-Agent for crawling and URL sources; defaults to ailoom-bot/<version> (+PUBLIC_URL)
# CRAWL_USER_AGENT=

# --- Model provider URLs ---

# auto (allowed unless SIGNUP_MODE=open), true, false; see docs/spec.md section 11.3
# ALLOW_PRIVATE_PROVIDER_URLS=auto

# Hosts/CIDRs provider base URLs may use, e.g. 192.168.1.20,ollama
# PROVIDER_URL_ALLOWLIST=

# Extra hosts/CIDRs always denied
# PROVIDER_URL_DENYLIST=

# Enable the built-in embedding model
# LOCAL_EMBEDDINGS=true

# Built-in embedding model for new bots: bge-small-en-v1.5 (English) or
# multilingual-e5-small (100+ languages). Existing bots keep their model.
# LOCAL_EMBEDDING_MODEL=bge-small-en-v1.5

# --- Retention ---

# Days to keep conversations; 0 keeps them forever
# RETENTION_CONVERSATIONS_DAYS=0

# Days to keep request traces (request snapshots are large); 0 keeps them forever
# RETENTION_TRACES_DAYS=90

# Days to keep revoked auth sessions; 0 keeps them forever
# RETENTION_SESSIONS_DAYS=90
