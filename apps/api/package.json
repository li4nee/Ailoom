{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/modules/auth/domain/common-passwords.txt', 'dist/modules/auth/domain/common-passwords.txt')\" && node -e \"require('node:fs').cpSync('src/providers/data', 'dist/providers/data', { recursive: true })\"",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "dev:worker": "node --watch -r @swc-node/register src/worker.ts",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "db:migrate": "node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:run --transaction each",
    "db:revert": "node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:revert --transaction each",
    "db:generate": "sh -c 'node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:generate \"src/db/migrations/$1\"' db-generate",
    "db:check": "node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:generate --dryrun --check src/db/migrations/Check",
    "secrets:generate": "node -r @swc-node/register src/cli/secrets-generate.ts",
    "fetch-model": "node -r @swc-node/register src/cli/fetch-model.ts"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.4.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "semver": "^7.8.6",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "typescript": "catalog:",
    "undici": "^8.12.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/groq": "^4.0.78",
    "@ai-sdk/mistral": "^4.0.81",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@ai-sdk/provider": "^4.0.37",
    "@app/shared": "workspace:*",
    "@huggingface/transformers": "^4.3.2",
    "@mozilla/readability": "0.6.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/platform-node": "^12.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "ai": "^7.0.165",
    "big.js": "^7.0.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.17",
    "linkedom": "0.18.15",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "10.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "6.37.0",
    "rxjs": "^7.8.2",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  }
}
