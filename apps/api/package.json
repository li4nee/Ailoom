{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "db:migrate": "node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:run",
    "db:revert": "node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:revert",
    "db:generate": "sh -c 'node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:generate \"src/db/migrations/$1\"' db-generate",
    "db:check": "node -r @swc-node/register node_modules/typeorm/cli.js -d src/db/cli-data-source.ts migration:generate --dryrun --check src/db/migrations/Check",
    "secrets:generate": "node -r @swc-node/register src/cli/secrets-generate.ts",
    "fetch-model": "node -r @swc-node/register src/cli/fetch-model.ts"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "semver": "^7.8.6",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "typescript": "catalog:",
    "undici": "^8.12.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:",
    "dependency-cruiser": "^18.7.2"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.37",
    "@app/shared": "workspace:*",
    "@huggingface/transformers": "^4.3.2",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-node": "^12.4.0",
    "ai": "^7.0.165",
    "ipaddr.js": "^2.5.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  }
}
