# SPDX-License-Identifier: AGPL-3.0-only
# Build context for apps/api/Dockerfile and deploy/web.Dockerfile (context = repo root).
# The lockfile, pnpm-workspace.yaml, .npmrc and LICENSE must stay in the context.

# VCS, tooling and local state
.git/
.github/
.superpowers/
.turbo/
**/.turbo/
.vscode/
.idea/
.pnpm-store/
**/node_modules/
**/dist/
**/coverage/
**/.astro/
**/*.tsbuildinfo
*.log
.DS_Store
*.swp
*~

# Secrets and local environment
**/.env
**/.env.*
!**/.env.example

# Downloaded embedding models: the api image fetches them itself (manifest stays)
apps/api/models/*
!apps/api/models/manifest.json

# Tests and docs are not part of either image
apps/docs/*
!apps/docs/package.json
**/test/
**/*.spec.ts
playwright-report/
test-results/

# Container definitions themselves
**/Dockerfile
**/*.Dockerfile
deploy/
!deploy/Caddyfile
.dockerignore
